# SMTP credentials for the /api/contact route (Google Workspace).
#
# These are required in production (Vercel project env vars) and locally
# in .env.local (gitignored) if you want to test the contact form.
#
# Generate an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Workspace account).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@martindrexler.com
SMTP_PASS=                       # 16-char app password — no spaces
MAIL_FROM=hello@martindrexler.com
MAIL_TO=hello@martindrexler.com
